# Code owners: exactly the human tier of factory policies/tiers.yaml (pinned in
# .github/factory/factory-version). The ruleset "main: code-owner review (human tier)" requires the
# owner's review for these paths only, so auto and auto-strict factory merges (src/locales/*/parsers,
# src/core, ...) never wait for a person. Keep this list in step with tiers.yaml `human`.
# Human tier: changes need the owner's review.

/.github/        @sabbasi3
/contracts/      @sabbasi3
/harness/        @sabbasi3
/tests/golden/   @sabbasi3
/upstream/       @sabbasi3
/NOTICE          @sabbasi3

# Owner-approved generated output (tiers.yaml `intake_fixes`): a bug-intake fix PR adds exactly these
# three files, every one regenerated byte for byte in CI from the pinned chrono-node, and the
# controller queues it only under that policy's conditions and daily cap. No owner, so the policy,
# not a review, decides (a later line with no owner clears ownership).
/contracts/*/fix-*.yaml
/harness/golden/fixes/*.json
/tests/golden/fixes/*.json

# Owner-approved generated output (tiers.yaml `onboarding`, factory policies/onboarding.yaml languages):
# a language-onboarding PR adds only harness/onboard/onboard.js output for one of these languages and
# updates the two golden indexes; CI regenerates every file byte for byte. No owner, so the policy decides.
# Hand-written changes to the indexes still fail golden:check unless upstream/ or harness/ (owned) change.
/tests/golden/index.json
/tests/golden/configurations.json
/contracts/fi/
/tests/golden/fi/
/harness/golden/coverage/fi.json
/contracts/id/
/tests/golden/id/
/harness/golden/coverage/id.json
/contracts/nl/
/tests/golden/nl/
/harness/golden/coverage/nl.json
/contracts/ru/
/tests/golden/ru/
/harness/golden/coverage/ru.json
/contracts/uk/
/tests/golden/uk/
/harness/golden/coverage/uk.json
/contracts/ar/
/tests/golden/ar/
/harness/golden/coverage/ar.json
/contracts/zh-hans/
/tests/golden/zh_hans/
/harness/golden/coverage/zh_hans.json
